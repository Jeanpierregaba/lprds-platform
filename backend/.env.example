# Copier en .env et compléter — jamais commiter le .env réel (secrets).

APP_NAME="LPRDS Backend"
APP_ENV=development
DEBUG=true

# Base de données Postgres (asyncpg)
DATABASE_URL=postgresql+asyncpg://adminlprds:lprds@localhost:5432/lprds_database
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis — révocation de tokens, cache, pub/sub messagerie temps réel
REDIS_URL=redis://localhost:6379/0

# JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-32-byte-hex-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Rotation des badges QR présences : après un changement de SECRET_KEY,
# renseigner ici l'ANCIENNE valeur le temps de réimprimer les badges.
# Vide par défaut (aucune ancienne clé acceptée).
# QR_KEY_PREVIOUS=

# Reset mot de passe (lien valide 1h)
RESET_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:3000

# Notifications push Web (PWA Phase 2) — couple de clés VAPID. Générer avec :
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); \
# print(v.private_key_b64()); print(v.public_key_b64())"
# VAPID_PRIVATE_KEY ne doit JAMAIS être exposée au frontend — seule la clé
# publique l'est (GET /api/v1/notifications/vapid-public-key).
VAPID_PRIVATE_KEY=change-me-generate-a-real-vapid-private-key
VAPID_PUBLIC_KEY=change-me-generate-a-real-vapid-public-key
VAPID_SUBJECT=mailto:no-reply@lespetitsrayonsdesoleil.fr

# Anti brute-force sur /auth/login (Redis, par IP+email) — voir claude.md
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Origines CORS supplémentaires, séparées par des virgules — FRONTEND_URL est
# toujours autorisée, inutile de la répéter ici.
CORS_EXTRA_ORIGINS=

# Email SMTP (ex: sandbox Mailtrap en dev) — voir MAIL_SUPPRESS_SEND ci-dessous
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.fr
MAIL_FROM_NAME=LPRDS Plateforme
MAIL_PORT=2525
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
# true = n'établit aucune connexion SMTP, les emails sont ignorés (utile en
# dev/test sans identifiants SMTP valides). À laisser à false en production.
MAIL_SUPPRESS_SEND=false

# Stockage fichiers — seul le backend "local" est implémenté pour l'instant
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./media

# Pièces jointes messagerie (défauts si absent : 10 Mo, 50 Mo vidéo) — tout
# MIME image/* est accepté en plus de la liste (sauf image/svg+xml) ; tout
# MIME video/* est accepté UNIQUEMENT dans les conversations privées (les
# diffusions restent images + PDF), avec son propre plafond vidéo.
MESSAGING_MAX_ATTACHMENT_MB=10
MESSAGING_MAX_VIDEO_MB=50
MESSAGING_ALLOWED_ATTACHMENT_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# Pièces jointes rapports (défauts si absent : 50 Mo). Outre cette liste
# explicite, TOUT MIME image/* ou video/* est accepté au runtime sauf
# image/svg+xml (cf. reports/service.py)
REPORTS_MAX_ATTACHMENT_MB=50
REPORTS_ALLOWED_ATTACHMENT_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/quicktime,video/webm

# Pièces jointes blog (défauts si absent : 50 Mo) — même sur-ensemble image/*
# ou video/* sauf image/svg+xml (cf. blog/service.py). L'image à la une est
# en plus filtrée aux seuls types "image/*" (cf. blog/service.py)
BLOG_MAX_ATTACHMENT_MB=50
BLOG_ALLOWED_ATTACHMENT_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/quicktime,video/webm

# Pièces jointes enfant — documents du dossier d'inscription (pièce d'identité,
# certificat médical, autorisations...). Défauts si absent : 10 Mo, images + PDF
# (la vidéo n'a pas de sens pour un dossier).
CHILDREN_MAX_ATTACHMENT_MB=10
CHILDREN_ALLOWED_ATTACHMENT_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# ── Tests uniquement (pytest, cf. tests/conftest.py) ──────────────
# Base dédiée aux tests, JAMAIS la base de dev — dérivée automatiquement de
# DATABASE_URL (suffixe "_test") si absente. Ne décommenter que pour pointer
# vers une base de test différente de la dérivation automatique.
# TEST_DATABASE_URL=postgresql+asyncpg://adminlprds:lprds@localhost:5432/lprds_database_test

# ── Traduction automatique du contenu saisi (blog, menus) ────────
# Le rédacteur n'écrit qu'en français ; la version anglaise est générée puis
# stockée (corrigeable à la main, jamais réécrite après correction).
# Best-effort strict : un échec ne bloque jamais une publication, le site
# vitrine retombe simplement sur le français.
# ⚠️ Laisser à false en dev et en test — sinon chaque publication d'article et
# chaque enregistrement de menu appelle une API payante.
TRANSLATION_ENABLED=false
#
# Moteur : "anthropic" (défaut, meilleure qualité, payant à l'appel) ou
# "libretranslate" (open source, auto-hébergeable, gratuit et sans limite).
# Les deux respectent le même contrat : changer de moteur ne demande que cette
# ligne, la mémoire de traduction et le repli valent pour les deux.
TRANSLATION_PROVIDER=anthropic
#
# --- moteur "anthropic" ---
ANTHROPIC_API_KEY=
# Tâche courte et cadrée, gros volume : pas besoin d'un modèle de raisonnement.
TRANSLATION_MODEL=claude-haiku-4-5
#
# --- moteur "libretranslate" ---
# Instance à joindre. Avec le service du docker-compose (profil "translate") :
#   docker compose --profile translate up -d
#   LIBRETRANSLATE_URL=http://libretranslate:5000
# Hors Docker, une instance locale écoute sur http://localhost:5000.
# ⚠️ Rien n'est envoyé à un tiers avec une instance auto-hébergée : le contenu
# de l'établissement ne quitte pas le serveur. Une instance PUBLIQUE, elle,
# verra passer les articles — à peser si cela compte.
LIBRETRANSLATE_URL=
# Uniquement pour une instance publique qui en exige une (libretranslate.com).
# Une instance auto-hébergée n'en demande aucune.
LIBRETRANSLATE_API_KEY=
# Au-delà, la requête HTTP n'attend plus : le statut reste "pending" et le
# rédacteur relance depuis l'interface (bouton « Retraduire »).
TRANSLATION_TIMEOUT_SECONDS=20
