    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "check-messages": "node scripts/check-messages.mjs",
    "check-hardcoded-text": "node scripts/check-hardcoded-text.mjs",
    "check-zod-messages": "node scripts/check-zod-messages.mjs",
    "check-password-policy": "node scripts/check-password-policy.mjs",
    "check-locale-resolution": "node scripts/check-locale-resolution.mjs",
    "check-marketing-slugs": "node scripts/check-marketing-slugs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@types/js-cookie": "^3.0.6",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "js-cookie": "^3.0.8",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
