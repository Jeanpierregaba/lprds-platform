{
  "name": "lprds-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/stamp-version.mjs",
    "build": "next build",
    "start": "next start",
